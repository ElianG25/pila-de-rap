# URL del Web App de Google Apps Script (Google Sheets) que sirve y recibe los datos de la liga.
# Requerida. Sin ella /api/league responde 500.
SHEETS_GET_URL=

# Notificaciones de inscripción a Telegram (opcionales; si faltan, simplemente no se envían).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Push notifications (PWA). Las VAPID se generan una sola vez con
# `npx web-push generate-vapid-keys` y no cambian entre entornos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Storage de suscripciones push + snapshot para detectar cambios. Cuenta free en upstash.com,
# pestaña "REST API" de la base de datos Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secreto compartido para que /api/cron/check-updates solo lo pueda invocar Vercel Cron.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
